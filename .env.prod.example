# Producao. Copie para .env.prod e preencha. NUNCA versione o .env.prod.
DEBUG=False
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"   (o sistema recusa chave fraca)
SECRET_KEY=
HTTPS=True
DOMINIO=erp.suaempresa.com.br
ALLOWED_HOSTS=erp.suaempresa.com.br
CSRF_TRUSTED_ORIGINS=https://erp.suaempresa.com.br
# internal = certificado local (rede interna); ou um e-mail para Let's Encrypt (dominio publico)
CADDY_TLS=internal
CACHE_NO_BANCO=True
SESSAO_HORAS=8
API_TOKEN_HORAS=8

DB_NAME=erp
DB_USER=erp
# Senha longa e aleatoria (o banco nao fica exposto, mas nao use a de desenvolvimento)
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
